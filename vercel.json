{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/landing",
      "destination": "/index.html"
    },
    {
      "source": "/scientist",
      "destination": "/scientist.html"
    },
    {
      "source": "/citizen",
      "destination": "/comare.html"
    },
    {
      "source": "/explorer",
      "destination": "/comare.html"
    }
  ],
  "headers": [
    {
      "source": "/frames_loader/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/frames_v2/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|svg|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}